# Room & Mess Finder - Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# SUPABASE (Required)
# ===========================================
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ===========================================
# AI CHATBOT - Google Gemini
# ===========================================
VITE_GEMINI_API_KEY=your_gemini_api_key

# ===========================================
# NOTIFICATIONS - Email (Optional)
# ===========================================
# For email notifications via Supabase Edge Functions
# Set up send-email Edge Function with these providers:

# SendGrid
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@roomandmess.com

# OR Resend
RESEND_API_KEY=your_resend_api_key

# ===========================================
# NOTIFICATIONS - WhatsApp (Optional)
# ===========================================
# WhatsApp Business API (via Meta Business Platform)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# OR Twilio for WhatsApp
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ===========================================
# PAYMENTS - Razorpay (Optional)
# ===========================================
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ===========================================
# GOOGLE MAPS (Optional - Using OpenStreetMap by default)
# ===========================================
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ===========================================
# AI AGENTS - Google ADK / Vertex AI (Optional)
# ===========================================
# For AI agent access to enquiry data
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
VERTEX_AI_LOCATION=us-central1

# ===========================================
# ANALYTICS (Optional)
# ===========================================
VITE_GA_TRACKING_ID=your_google_analytics_id
VITE_MIXPANEL_TOKEN=your_mixpanel_token
